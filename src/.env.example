# Application
APP_NAME=AGENT-ISHMS
APP_VERSION=0.1
DEFAULT_LANG=en
PRIMARY_LANG=en

# Uploads (matches the current local configuration)
FILE_ALLOWED_TYPES=["text/plain", "application/pdf", "text/csv", "application/csv"]
FILE_MAX_SIZE=10
FILE_CHHUNK_SIZE=512000

# PostgreSQL / pgvector
# Use the same username, password, and database in docker/env/.env.postgres.
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_HOST=pgvector
POSTGRES_PORT=5432
POSTGRES_MAIN_DATABASE=agent-ishms
VECTOR_DB_BACKEND=PGVector
VECTOR_DB_DISTANCE_METRIC=cosine
VECTOR_DB_PGVEC_INDEX_THRESHOLD=1000

# Required by the current settings/factory, even with PGVector selected.
VECTOR_DB_PATH=qdrant_db

# RAG answer generation: A2Agent through the OpenAI-compatible adapter.
# OPENAI_API_KEY and A2AGENT_API_KEY must contain the same A2Agent key.
GENERATION_PROVIDER=OPENAI
GENERATION_MODEL_ID=minimax-m3.1-flash
OPENAI_BASE_URL=https://api.a2agent.me/v1
OPENAI_API_KEY=your-a2agent-api-key

# Primary voice conversation provider
A2AGENT_API_KEY=your-a2agent-api-key
A2AGENT_BASE_URL=https://api.a2agent.me/v1
A2AGENT_MODEL_ID=minimax-m3.1-flash

# Voice generation fallbacks currently configured locally.
# Leave a fallback key empty if you do not want to enable that provider.
GOOGLE_AI_API_KEY=your-google-ai-api-key
GOOGLE_AI_BASE_URL=
OPENROUTER_API_KEY=your-openrouter-api-key

# NVIDIA NIM embeddings: separate from generation URL and credentials.
EMBEDDING_PROVIDER=OPENAI
EMBEDDING_MODEL_ID=nvidia/nemotron-3-embed-1b
EMBEDDING_MODEL_SIZE=2048
EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
EMBEDDING_API_KEY=your-nvidia-api-key

# Optional OCR fallback for scanned PDF pages; leave empty to skip remote OCR.
OCR_SPACE_API_KEY=

# Compatibility placeholders: current Settings validation still requires these
# even though the active pipeline does not use these integrations/options.
NARA_BASE_URL=
NARA_API_KEY=
COHERE_API_KEY=
VECTOR_DB_BACKEND_LITTERAL=[]

# LiveKit, Groq STT, Langfuse, and Edge TTS configuration lives in
# the separate root-level .env.voice file (see .env.voice.example).



################ Template Configs ################
Default_Lang = "en"
DEFAULT_LANG = "en"
PRIMARY_LANG = "en" 


